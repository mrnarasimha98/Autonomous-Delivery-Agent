import heapq
import math
import random
import time


# ============================================================
# AUTONOMOUS DELIVERY AGENT
# ============================================================
# 0 = Obstacle / blocked road
# 1 = Normal road (cost 1)
# 2 = Road with cost 2
# 3 = Road with cost 3
# etc.
#
# The user enters:
#   - Grid size
#   - Grid/map
#   - Start location
#   - Delivery location
#
# Algorithms:
#   1. Uniform Cost Search (UCS)
#   2. A* Search
#   3. Simulated Annealing (SA)
#
# A* is used as the main navigation algorithm.
# ============================================================


# ============================================================
# GRID WORLD
# ============================================================

class GridWorld:

    def __init__(self, grid, start, goal):

        self.grid = grid
        self.rows = len(grid)
        self.cols = len(grid[0])

        self.start = start
        self.goal = goal

        # Minimum positive movement cost
        positive_costs = [
            cell
            for row in grid
            for cell in row
            if cell > 0
        ]

        self.min_cost = min(positive_costs)


    def is_valid(self, position):

        r, c = position

        return (
            0 <= r < self.rows
            and 0 <= c < self.cols
            and self.grid[r][c] > 0
        )


    def get_cost(self, position):

        r, c = position

        return self.grid[r][c]


    def neighbors(self, position):

        r, c = position

        # Up, Down, Left, Right
        directions = [
            (-1, 0),
            (1, 0),
            (0, -1),
            (0, 1)
        ]

        for dr, dc in directions:

            next_position = (
                r + dr,
                c + dc
            )

            if self.is_valid(next_position):

                yield (
                    next_position,
                    self.get_cost(next_position)
                )


# ============================================================
# COMMON FUNCTIONS
# ============================================================

def manhattan(a, b):

    return (
        abs(a[0] - b[0])
        + abs(a[1] - b[1])
    )


def reconstruct_path(came_from, current):

    path = []

    while current is not None:

        path.append(current)

        current = came_from[current]

    path.reverse()

    return path


# ============================================================
# DISTANCE CALCULATION
# ============================================================

def calculate_distance(path):

    """
    Distance = number of movements/steps.

    Example:
    [(0,0), (0,1), (0,2)]
    Distance = 2
    """

    if not path or len(path) < 2:

        return 0

    distance = 0

    for i in range(len(path) - 1):

        current = path[i]
        next_position = path[i + 1]

        distance += manhattan(
            current,
            next_position
        )

    return distance


# ============================================================
# PATH COST
# ============================================================

def calculate_cost(world, path):

    """
    Total cost is the sum of the cost
    of every road/cell entered.
    """

    if not path:

        return math.inf

    total_cost = 0

    for position in path[1:]:

        total_cost += world.get_cost(
            position
        )

    return total_cost


# ============================================================
# PATH VALIDATION
# ============================================================

def validate_path(world, path):

    if not path:

        return False

    if path[0] != world.start:

        return False

    if path[-1] != world.goal:

        return False

    for i in range(len(path) - 1):

        current = path[i]
        next_position = path[i + 1]

        # Both cells must be valid
        if not world.is_valid(current):

            return False

        if not world.is_valid(next_position):

            return False

        # Must move only one cell
        if manhattan(
            current,
            next_position
        ) != 1:

            return False

    return True


# ============================================================
# 1. UNIFORM COST SEARCH
# ============================================================

def uniform_cost_search(world):

    start = world.start
    goal = world.goal

    # Priority queue:
    # (cost, position)
    frontier = []

    heapq.heappush(
        frontier,
        (0, start)
    )

    cost_so_far = {
        start: 0
    }

    came_from = {
        start: None
    }

    visited = set()

    nodes_expanded = 0

    start_time = time.perf_counter()

    while frontier:

        current_cost, current = heapq.heappop(
            frontier
        )

        if current in visited:

            continue

        visited.add(current)

        nodes_expanded += 1

        # Goal reached
        if current == goal:

            path = reconstruct_path(
                came_from,
                current
            )

            execution_time = (
                time.perf_counter()
                - start_time
            )

            return {
                "cost": current_cost,
                "distance": calculate_distance(path),
                "path": path,
                "path_length": len(path),
                "nodes": nodes_expanded,
                "time": execution_time
            }

        # Explore neighbors
        for neighbor, movement_cost in world.neighbors(
            current
        ):

            new_cost = (
                cost_so_far[current]
                + movement_cost
            )

            if new_cost < cost_so_far.get(
                neighbor,
                math.inf
            ):

                cost_so_far[neighbor] = new_cost

                came_from[neighbor] = current

                heapq.heappush(
                    frontier,
                    (
                        new_cost,
                        neighbor
                    )
                )

    return None


# ============================================================
# 2. A* SEARCH
# ============================================================

def a_star_search(world):

    start = world.start
    goal = world.goal

    # Heuristic
    def heuristic(position):

        return (
            manhattan(
                position,
                goal
            )
            * world.min_cost
        )

    # Priority queue:
    # (f = g + h, g, position)

    frontier = []

    heapq.heappush(
        frontier,
        (
            heuristic(start),
            0,
            start
        )
    )

    cost_so_far = {
        start: 0
    }

    came_from = {
        start: None
    }

    visited = set()

    nodes_expanded = 0

    start_time = time.perf_counter()

    while frontier:

        f_cost, current_cost, current = heapq.heappop(
            frontier
        )

        if current in visited:

            continue

        visited.add(current)

        nodes_expanded += 1

        # Goal reached
        if current == goal:

            path = reconstruct_path(
                came_from,
                current
            )

            execution_time = (
                time.perf_counter()
                - start_time
            )

            return {
                "cost": current_cost,
                "distance": calculate_distance(path),
                "path": path,
                "path_length": len(path),
                "nodes": nodes_expanded,
                "time": execution_time
            }

        # Explore neighbors
        for neighbor, movement_cost in world.neighbors(
            current
        ):

            new_cost = (
                cost_so_far[current]
                + movement_cost
            )

            if new_cost < cost_so_far.get(
                neighbor,
                math.inf
            ):

                cost_so_far[neighbor] = new_cost

                came_from[neighbor] = current

                f = (
                    new_cost
                    + heuristic(neighbor)
                )

                heapq.heappush(
                    frontier,
                    (
                        f,
                        new_cost,
                        neighbor
                    )
                )

    return None


# ============================================================
# SIMULATED ANNEALING - HELPER
# ============================================================

def random_valid_path(
    world,
    start,
    goal,
    rng
):

    """
    Generates a valid path using randomized
    depth-first search with backtracking.
    """

    visited = set()

    path = []

    def dfs(current):

        path.append(current)

        if current == goal:

            return True

        visited.add(current)

        neighbors = list(
            world.neighbors(current)
        )

        rng.shuffle(neighbors)

        # Prefer cells closer to goal
        neighbors.sort(
            key=lambda item:
            manhattan(
                item[0],
                goal
            )
            + rng.random() * 2
        )

        for neighbor, _ in neighbors:

            if neighbor not in visited:

                if dfs(neighbor):

                    return True

        path.pop()

        return False

    if dfs(start):

        return path[:]

    return None


# ============================================================
# SIMULATED ANNEALING
# ============================================================

def simulated_annealing(
    world,
    iterations=500,
    initial_temperature=20,
    cooling_rate=0.98
):

    """
    Simulated Annealing is used as an optimization
    comparison algorithm.

    A* first provides a guaranteed valid route.
    SA then searches for alternative routes.
    """

    # Get a guaranteed initial route
    initial_result = a_star_search(
        world
    )

    if initial_result is None:

        return None

    current_path = initial_result["path"][:]

    current_cost = calculate_cost(
        world,
        current_path
    )

    best_path = current_path[:]

    best_cost = current_cost

    temperature = initial_temperature

    rng = random.Random()

    accepted_moves = 0

    start_time = time.perf_counter()

    for _ in range(iterations):

        new_path = random_valid_path(
            world,
            world.start,
            world.goal,
            rng
        )

        if new_path is None:

            continue

        if not validate_path(
            world,
            new_path
        ):

            continue

        new_cost = calculate_cost(
            world,
            new_path
        )

        difference = (
            new_cost
            - current_cost
        )

        # Accept better paths
        # or occasionally accept worse paths
        if (
            difference <= 0
            or rng.random()
            < math.exp(
                -difference
                / max(
                    temperature,
                    0.000001
                )
            )
        ):

            current_path = new_path

            current_cost = new_cost

            accepted_moves += 1

            if current_cost < best_cost:

                best_cost = current_cost

                best_path = current_path[:]

        temperature *= cooling_rate

        if temperature < 0.000001:

            temperature = 0.000001

    execution_time = (
        time.perf_counter()
        - start_time
    )

    return {
        "cost": best_cost,
        "distance": calculate_distance(
            best_path
        ),
        "path": best_path,
        "path_length": len(best_path),
        "nodes": iterations,
        "time": execution_time,
        "accepted": accepted_moves
    }


# ============================================================
# DISPLAY ALGORITHM RESULT
# ============================================================

def display_result(
    algorithm_name,
    result
):

    if result is None:

        print(
            f"{algorithm_name}: "
            "No path found"
        )

        return

    print(
        f"{algorithm_name}:"
    )

    print(
        f"  Distance       : "
        f"{result['distance']} steps"
    )

    print(
        f"  Total Cost     : "
        f"{result['cost']}"
    )

    print(
        f"  Path Locations : "
        f"{result['path_length']}"
    )

    print(
        f"  Nodes Expanded : "
        f"{result['nodes']}"
    )

    print(
        f"  Execution Time : "
        f"{result['time']:.6f} seconds"
    )


# ============================================================
# GET USER INPUT
# ============================================================

def get_user_map():

    print()
    print("=" * 65)
    print("       AUTONOMOUS DELIVERY AGENT")
    print("=" * 65)

    print()
    print("MAP VALUES:")
    print("0 = Obstacle / blocked road")
    print("1 = Normal road")
    print("2 = Road cost 2")
    print("3 = Road cost 3")
    print("etc.")

    # --------------------------------------------------------
    # GRID SIZE
    # --------------------------------------------------------

    while True:

        try:

            rows = int(
                input(
                    "\nEnter number of rows: "
                )
            )

            cols = int(
                input(
                    "Enter number of columns: "
                )
            )

            if rows >= 2 and cols >= 2:

                break

            print(
                "Rows and columns must be "
                "at least 2."
            )

        except ValueError:

            print(
                "Please enter valid numbers."
            )

    # --------------------------------------------------------
    # GRID
    # --------------------------------------------------------

    print()
    print(
        "Enter the map row by row."
    )

    print(
        "Example: 1 1 1 0 1"
    )

    grid = []

    for row_number in range(rows):

        while True:

            try:

                row = list(
                    map(
                        int,
                        input(
                            f"Row {row_number}: "
                        ).split()
                    )
                )

                if len(row) != cols:

                    print(
                        f"Please enter exactly "
                        f"{cols} values."
                    )

                    continue

                if any(
                    value < 0
                    for value in row
                ):

                    print(
                        "Values cannot be negative."
                    )

                    continue

                grid.append(row)

                break

            except ValueError:

                print(
                    "Enter numbers separated "
                    "by spaces."
                )

    # --------------------------------------------------------
    # START POSITION
    # --------------------------------------------------------

    while True:

        try:

            print()
            print(
                "Enter START position"
            )

            start_row = int(
                input("Start row: ")
            )

            start_col = int(
                input("Start column: ")
            )

            start = (
                start_row,
                start_col
            )

            if (
                0 <= start_row < rows
                and
                0 <= start_col < cols
                and
                grid[start_row][start_col] > 0
            ):

                break

            print(
                "Invalid or blocked "
                "start position."
            )

        except ValueError:

            print(
                "Enter valid numbers."
            )

    # --------------------------------------------------------
    # DELIVERY POSITION
    # --------------------------------------------------------

    while True:

        try:

            print()
            print(
                "Enter DELIVERY position"
            )

            goal_row = int(
                input("Delivery row: ")
            )

            goal_col = int(
                input("Delivery column: ")
            )

            goal = (
                goal_row,
                goal_col
            )

            if (
                0 <= goal_row < rows
                and
                0 <= goal_col < cols
                and
                grid[goal_row][goal_col] > 0
            ):

                break

            print(
                "Invalid or blocked "
                "delivery position."
            )

        except ValueError:

            print(
                "Enter valid numbers."
            )

    return GridWorld(
        grid,
        start,
        goal
    )


# ============================================================
# DISPLAY MAP
# ============================================================

def display_map(
    world,
    path=None
):

    print()
    print("MAP")
    print("-" * 40)

    path_set = set(
        path
        if path
        else []
    )

    for r in range(world.rows):

        output = []

        for c in range(world.cols):

            position = (
                r,
                c
            )

            if position == world.start:

                output.append("S")

            elif position == world.goal:

                output.append("G")

            elif position in path_set:

                output.append("*")

            elif world.grid[r][c] == 0:

                output.append("#")

            else:

                output.append(
                    str(world.grid[r][c])
                )

        print(
            " ".join(output)
        )

    print()
    print("S = Start")
    print("G = Delivery")
    print("* = Planned route")
    print("# = Obstacle")


# ============================================================
# DYNAMIC OBSTACLE REPLANNING
# ============================================================

def dynamic_replanning(
    world,
    initial_result
):

    print()
    print("=" * 65)
    print("       DYNAMIC OBSTACLE REPLANNING")
    print("=" * 65)

    original_path = (
        initial_result["path"]
    )

    # Need at least a few movements
    if len(original_path) < 5:

        print(
            "\nPath is too short for "
            "dynamic obstacle demonstration."
        )

        return

    # --------------------------------------------------------
    # AGENT MOVES
    # --------------------------------------------------------

    current_position = (
        original_path[3]
    )

    print()
    print(
        "Initial route:"
    )

    print(
        original_path
    )

    print()
    print(
        "Agent has moved 3 steps."
    )

    print(
        "Current position:",
        current_position
    )

    # --------------------------------------------------------
    # FIND A CELL TO BLOCK
    # --------------------------------------------------------

    obstacle_position = None

    for position in original_path[4:-1]:

        if position != world.goal:

            obstacle_position = position

            break

    if obstacle_position is None:

        print(
            "Unable to create dynamic "
            "obstacle for this route."
        )

        return

    print()
    print(
        "Dynamic obstacle detected at:",
        obstacle_position
    )

    # --------------------------------------------------------
    # CREATE UPDATED MAP
    # --------------------------------------------------------

    new_grid = [
        row[:]
        for row in world.grid
    ]

    r, c = obstacle_position

    new_grid[r][c] = 0

    # New world starts from agent's
    # current position
    updated_world = GridWorld(
        new_grid,
        current_position,
        world.goal
    )

    # --------------------------------------------------------
    # REPLAN USING A*
    # --------------------------------------------------------

    print()
    print(
        "Replanning route using A*..."
    )

    replanned_result = a_star_search(
        updated_world
    )

    if replanned_result is None:

        print()
        print(
            "No alternative route exists."
        )

        return

    print()
    print(
        "NEW ROUTE:"
    )

    print(
        replanned_result["path"]
    )

    print()
    print(
        "New Distance:",
        replanned_result["distance"],
        "steps"
    )

    print(
        "New Cost:",
        replanned_result["cost"]
    )

    print(
        "New Nodes Expanded:",
        replanned_result["nodes"]
    )

    print(
        "New Execution Time:",
        f"{replanned_result['time']:.6f}",
        "seconds"
    )

    print(
        "Path Valid:",
        validate_path(
            updated_world,
            replanned_result["path"]
        )
    )

    print()
    print(
        "UPDATED MAP:"
    )

    display_map(
        updated_world,
        replanned_result["path"]
    )


# ============================================================
# DELIVERY SIMULATION
# ============================================================

def delivery_simulation(
    world,
    result
):

    print()
    print("=" * 65)
    print("       DELIVERY SIMULATION")
    print("=" * 65)

    print()
    print(
        "Starting autonomous delivery..."
    )

    print(
        "Start:",
        world.start
    )

    print(
        "Delivery:",
        world.goal
    )

    print()
    print(
        "Agent movement:"
    )

    for step, position in enumerate(
        result["path"]
    ):

        print(
            f"Step {step}: "
            f"Agent at {position}"
        )

    print()
    print(
        "Delivery completed successfully!"
    )

    print(
        "Total Distance:",
        result["distance"],
        "steps"
    )

    print(
        "Total Cost:",
        result["cost"]
    )


# ============================================================
# MAIN PROGRAM
# ============================================================

def main():

    # --------------------------------------------------------
    # GET NEW DATA FROM USER
    # --------------------------------------------------------

    world = get_user_map()

    # --------------------------------------------------------
    # DISPLAY USER MAP
    # --------------------------------------------------------

    print()
    print("=" * 65)
    print("       YOUR DELIVERY MAP")
    print("=" * 65)

    display_map(world)

    # --------------------------------------------------------
    # RUN UCS
    # --------------------------------------------------------

    print()
    print(
        "Running Uniform Cost Search..."
    )

    ucs_result = uniform_cost_search(
        world
    )

    # --------------------------------------------------------
    # RUN A*
    # --------------------------------------------------------

    print(
        "Running A* Search..."
    )

    astar_result = a_star_search(
        world
    )

    # --------------------------------------------------------
    # CHECK ROUTE
    # --------------------------------------------------------

    if astar_result is None:

        print()
        print("=" * 65)
        print("DELIVERY NOT POSSIBLE")
        print("=" * 65)

        print()
        print(
            "No valid route exists between "
            "the start and delivery location."
        )

        return

    # --------------------------------------------------------
    # RUN SIMULATED ANNEALING
    # --------------------------------------------------------

    print(
        "Running Simulated Annealing..."
    )

    sa_result = simulated_annealing(
        world
    )

    # --------------------------------------------------------
    # RESULTS
    # --------------------------------------------------------

    print()
    print("=" * 65)
    print("       ALGORITHM COMPARISON")
    print("=" * 65)

    print()

    display_result(
        "UNIFORM COST SEARCH",
        ucs_result
    )

    print()

    display_result(
        "A* SEARCH",
        astar_result
    )

    print()

    display_result(
        "SIMULATED ANNEALING",
        sa_result
    )

    # --------------------------------------------------------
    # MAIN ROUTE
    # --------------------------------------------------------

    print()
    print("=" * 65)
    print("       AUTONOMOUS DELIVERY ROUTE")
    print("=" * 65)

    print()
    print(
        "A* is selected as the main "
        "navigation algorithm."
    )

    print()
    print(
        "Optimal Route:"
    )

    print(
        astar_result["path"]
    )

    print()
    print(
        "Distance:",
        astar_result["distance"],
        "steps"
    )

    print(
        "Total Cost:",
        astar_result["cost"]
    )

    print(
        "Path Locations:",
        astar_result["path_length"]
    )

    print(
        "Nodes Expanded:",
        astar_result["nodes"]
    )

    print(
        "Execution Time:",
        f"{astar_result['time']:.6f}",
        "seconds"
    )

    print(
        "Path Valid:",
        validate_path(
            world,
            astar_result["path"]
        )
    )

    # --------------------------------------------------------
    # DISPLAY ROUTE MAP
    # --------------------------------------------------------

    print()
    print(
        "ROUTE MAP:"
    )

    display_map(
        world,
        astar_result["path"]
    )

    # --------------------------------------------------------
    # DYNAMIC OBSTACLE
    # --------------------------------------------------------

    print()

    choice = input(
        "Do you want to simulate a "
        "dynamic obstacle? (y/n): "
    ).strip().lower()

    if choice == "y":

        dynamic_replanning(
            world,
            astar_result
        )

    # --------------------------------------------------------
    # DELIVERY SIMULATION
    # --------------------------------------------------------

    delivery_simulation(
        world,
        astar_result
    )


# ============================================================
# PROGRAM START
# ============================================================

if __name__ == "__main__":

    main()
